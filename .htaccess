RewriteEngine On

# Nunca servir documentación interna, fuentes SQL ni archivos de proyecto (aunque lleguen a estar en el servidor)
RewriteRule ^(docs|webService/sql)(/|$) - [F,L,NC]
RewriteRule (^|/)[^/]+\.(sql|md)$ - [F,L,NC]
# Archivos y carpetas ocultos (.env, .git, .github, .gitignore…) y de configuración del proyecto: nunca por URL.
# No depende de que el hosting los bloquee. .well-known queda libre (certificados SSL).
RewriteRule (^|/)\.(?!well-known(/|$)) - [F,L,NC]
RewriteRule (^|/)[^/]+\.(neon|ya?ml|sh|lock|dist|example|respaldo)$ - [F,L,NC]
RewriteRule (^|/)Dockerfile$ - [F,L,NC]

# Código interno: solo se carga desde PHP, nunca por URL. (REDIRECT_STATUS vacío = la petición del navegador,
# no la reescritura interna hacia index.php o apiService/index.php.)
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteRule ^(apiService/(core|middleware|storage|tests|tools)|webService/(controllers|business|models|libs|views)|sql)(/|$) - [F,L,NC]
# Ningún .php se ejecuta directo salvo las dos entradas.
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteRule ^(?!index\.php$|apiService/index\.php$).+\.php$ - [F,L,NC]

# /api/* → apiService/index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^api(/.*)?$ apiService/index.php [QSA,L]

# Archivos y directorios físicos pasan directo
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [QSA,L]


# ── Carga rápida: el servidor comprime lo que es texto antes de mandarlo (HTML, CSS, JS, JSON, SVG).
# El navegador lo descomprime solo. Brotli si el servidor lo tiene; si no, gzip.
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml application/xml
</IfModule>
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml application/xml
</IfModule>

# ── Cabeceras de seguridad (las de todos los archivos). La CSP y HSTS las manda PHP en sendSecurityHeaders():
# la CSP solo importa en las páginas, y la condición de HTTPS para HSTS no la entienden todos los servidores.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    Header always unset X-Powered-By
</IfModule>

# Imágenes y fuentes casi no cambian: el navegador las guarda 30 días y no las vuelve a pedir.
# (CSS y JS no se incluyen: no todos llevan versión en su URL y se quedarían viejos tras un despliegue.)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png     "access plus 30 days"
    ExpiresByType image/jpeg    "access plus 30 days"
    ExpiresByType image/webp    "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType font/woff2    "access plus 30 days"
</IfModule>
