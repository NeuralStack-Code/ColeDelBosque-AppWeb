# Entorno local del colegio. Copia este archivo como .env.local (no se sube: está en .gitignore).
# Pisa lo del .env del código, que apunta a PRODUCCIÓN.

# Tu MySQL/MariaDB local. El nombre de la base DEBE terminar en _local (el router se niega con otro).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=colegio_local

# Llaves de prueba (NO las de producción). Con estas se cifran las matrículas de las cuentas de prueba.
CRYPTO_KEY=clave-de-prueba-local-32-bytes!!
CRYPTO_IV=1234567890abcdef

# La api falsa de esta carpeta (licencia válida; los correos se guardan en correos.log).
API_BASE_URL=http://127.0.0.1:8788/v1
KEY_TOKEN=prueba-local

BASE_URL=
APP_URL=http://localhost:8787
MAIL_TO=buzon@prueba.test
