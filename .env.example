# Guía del .env (cada quien crea el suyo una vez; nunca pongas valores reales aquí)
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
MAIL_TO=
# API central de NeuralStack Code (licencia, correo, actualizador del framework)
KEY_TOKEN=
API_BASE_URL=
# Cifrado de matrículas y correos (webService/libs/Cifrado.php, AES-256-CBC)
CRYPTO_KEY=
CRYPTO_IV=
# Solo si el sitio vive en una subcarpeta
BASE_URL=
